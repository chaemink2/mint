# Mint 환경변수 템플릿 — 실제 값을 채워 `.env`로 복사하세요.

# ── 한국투자증권 KIS (실전 키 사용, 단 주문은 paper 모드) ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                  # 계좌번호 앞 8자리
KIS_ACCOUNT_CODE=01              # 상품코드
KIS_MOCK=false                   # 실전 데이터 사용 (true=모의투자 데이터)
KIS_TRADE_MODE=paper             # paper: 시뮬레이션 매매 / live: 실주문 (한투 거래 시작 후 변경)

# ── 카카오 알림톡 (비즈니스 채널 + 템플릿 승인 필요) ───────
KAKAO_REST_API_KEY=
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
KAKAO_TEMPLATE_ID=
KAKAO_RECEIVER_PHONE=            # 알림톡 수신자 휴대폰 번호

# ── 미국 시장 실시간 (Alpaca 또는 Polygon 택1) ────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

POLYGON_API_KEY=

# ── Mint 운영 ─────────────────────────────────────
MINT_DB_PATH=mint/data/mint.db
MINT_MODE=scan-once
MINT_US_SCAN=false
MINT_USE_ML_CONFIDENCE=false      # true면 학습된 LightGBM 확률로 시그널 필터링
MINT_MIN_ML_CONFIDENCE=0.70       # P(win) 임계값
MINT_MODEL_PATH=mint/data/models/mint_lgbm.joblib
MINT_WATCHLIST_SIZE=              # 비우면 static 10개. 100 등 숫자 지정 시 시총 상위 N개
MINT_SIGNAL_VALID_MIN=30
MINT_SIGNAL_DEDUP_H=4
MINT_DAEMON=0

# pykrx (선택 — 일부 KRX API용)
# KRX_ID=
# KRX_PW=
